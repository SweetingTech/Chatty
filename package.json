{
  "name": "multi-llm-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js && concurrently -k \"npm run start:chroma\" \"npm run wait-and-start\"",
    "dev": "node scripts/start.js && concurrently -k \"npm run start:chroma\" \"npm run wait-and-start\"",
    "start:chroma": "venv\\Scripts\\python start_chroma.py",
    "wait-and-start": "wait-on tcp:8001 && vite",
    "init-db": "node scripts/init-chromadb.js && node scripts/init-weaviate.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress run",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.2",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.24.1",
    "@xenova/transformers": "^2.17.2",
    "buffer": "^6.0.3",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.7",
    "isomorphic-fetch": "^3.0.0",
    "jest-fetch-mock": "^3.0.3",
    "lucide-react": "^0.344.0",
    "nanoid": "^5.0.6",
    "node-fetch": "^3.3.2",
    "openai": "^4.28.0",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-router-dom": "^6.22.1",
    "util": "^0.12.5",
    "weaviate-ts-client": "^2.2.0",
    "zod": "^3.24.1",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.12.18",
    "@eslint/js": "^9.9.1",
    "@testing-library/cypress": "^10.0.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/jquery": "^3.5.29",
    "@types/mocha": "^10.0.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cypress": "^13.6.6",
    "cypress-real-events": "^1.11.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "find-process": "^1.4.10",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "object-hash": "^3.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wait-on": "^5.3.0"
