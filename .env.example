# LM Studio Configuration
VITE_LM_STUDIO_HOST=localhost
VITE_LM_STUDIO_PORT=1234

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_API_KEY=your_api_key_here
CHROMA_COLLECTION_NAME=chat_sessions
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_LOG_LEVEL=INFO

# Weaviate Configuration
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_API_KEY=your_weaviate_api_key
WEAVIATE_SCHEMA_CLASS=ChatSession
WEAVIATE_BATCH_SIZE=100
WEAVIATE_VECTORIZER_MODULE=text2vec-transformers

# OpenAI Configuration (for Weaviate vectorizer)
OPENAI_API_KEY=your_openai_api_key

# Claude Configuration
CLAUDE_API_KEY=your_claude_api_key

# Deepseek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key

# Vite Configuration
VITE_APP_NAME=Chatty
VITE_API_BASE_URL=http://localhost:3000
VITE_ENABLE_DEBUG=true

# MCP Configuration
VITE_MCP_HOST=localhost
VITE_MCP_PORT=3001
VITE_MCP_CLIENT_NAME=default-client

# Authentication
AUTH_SECRET_KEY=your-secret-key-32-chars-long
AUTH_TOKEN_EXPIRATION=86400

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
